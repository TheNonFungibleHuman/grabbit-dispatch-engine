# WasenderAPI — https://wasenderapi.com
# Set these in Vercel Project Settings → Environment Variables

# Required for /webhook signature verification (X-Webhook-Signature)
WASENDER_WEBHOOK_SECRET=

# Session API key (available after the WhatsApp session connects)
WASENDER_API_KEY=

# Optional overrides
# WASENDER_API_BASE_URL=https://www.wasenderapi.com/api

# DeepSeek API — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Optional model override (default: deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat
# Optional base URL override (default: https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Kilo Business Delivery API — https://docs.kiloapp.org
KILO_API_KEY=
KILO_WEBHOOK_SECRET=
# Dashboard → Settings → API & Webhooks: subscribe to delivery.otp_issued and
# turn "OTP via webhook only" ON so this app sends the code on WhatsApp
# (works even when the admin AI kill switch is OFF).
# KILO_API_BASE_URL=https://business.kiloapp.org/api/v1
# KILO_DELIVERY_MODE=pickup
# KILO_COLLECTION_METHOD=cash_on_delivery
# KILO_WAREHOUSE_ID=

# Supabase (Database + Storage for transcripts, drafts, images) — https://supabase.com
# Create a free project -> Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# Optional legacy fallback: Vercel Blob (package photos + delivery records)
# https://vercel.com/docs/storage/vercel-blob
# BLOB_READ_WRITE_TOKEN=

# Rider availability schedule (Mauritius time). Prefer publish/exportable Sheet CSV.
# Falls back to data/rider-schedule.csv if remote fetch fails.
# GRABBIT_SCHEDULE_SHEET_ID=YOUR_GOOGLE_SHEET_ID
# GRABBIT_SCHEDULE_SHEET_GID=0
# Or a direct CSV URL:
# GRABBIT_SCHEDULE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/SHEET_ID/export?format=csv&gid=0

# Admin panel (/admin) — single shared password, no user accounts
ADMIN_PASSWORD=
# Optional; defaults to ADMIN_PASSWORD if unset
# ADMIN_SESSION_SECRET=

# Test Rider Phone override (sends all rider confirmation WhatsApps to this number)
# TEST_RIDER_PHONE=+99900000027

# Custom Tracking Link Base URL (defaults to https://delivery.grabbit-express.com/track)
# TRACKING_URL_BASE=https://delivery.grabbit-express.com/track

